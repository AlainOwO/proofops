{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Grounded change explanation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "finding_codes",
    "cited_facts",
    "next_step",
    "limitations"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1400
    },
    "finding_codes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "cited_facts": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "value"
        ],
        "properties": {
          "fact_id": {
            "type": "string"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "next_step": {
      "enum": [
        "revise_change",
        "collect_evidence",
        "request_review"
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "string"
      }
    }
  }
}
