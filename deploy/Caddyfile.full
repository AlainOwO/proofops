# Reuse the public hostname, TLS policy, security headers and unknown-host rejection.
import /etc/caddy/Caddyfile.public

http://{$FULL_DOMAIN} {
	import security_headers
	redir https://{$FULL_DOMAIN}{uri} 308
}

https://{$FULL_DOMAIN} {
	import security_headers
	header Strict-Transport-Security "max-age=31536000"
	route {
		# Every full-host path and method passes this gate before reaching an upstream.
		basic_auth {
			{$FULL_BASIC_AUTH_USER} {$FULL_BASIC_AUTH_HASH}
		}
		@api path /api/* /healthz /readyz /docs /docs/* /redoc /openapi.json
		handle @api {
			reverse_proxy full-api:8000 {
				header_up -Authorization
				transport http {
					dial_timeout 2s
					response_header_timeout 25s
				}
			}
		}
		handle {
			reverse_proxy full-web:8080 {
				header_up -Authorization
				transport http {
					dial_timeout 2s
					response_header_timeout 25s
				}
			}
		}
	}
	handle_errors {
		import security_headers
		header Strict-Transport-Security "max-age=31536000"
		respond "Service unavailable." {err.status_code}
	}
}
