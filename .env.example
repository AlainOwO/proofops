# Local development only. Never put real keys in source control.
DATABASE_URL=postgresql+psycopg://proofops:proofops_local@127.0.0.1:55432/proofops
ARTIFACT_DIR=artifacts
AI_MODE=off
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ALLOWED_PROVIDERS=
CHEAP_PROVIDER=openai
CHEAP_MODEL=
STRONG_PROVIDER=anthropic
STRONG_MODEL=
MODEL_PRICES_PATH=config/model_prices.json
AI_BUDGET_USD=0
AI_MAX_TASK_COST_USD=0
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_OUTPUT_TOKENS=1200
AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
AWS_PROFILE=
AWS_CLUSTER=
AWS_SERVICE=
AWS_LOG_GROUP=
AWS_LOOKBACK_SECONDS=3600
AWS_MAX_CALLS=12
# Dated rates come from the bundle's rates.json or an explicit CLI --rate-card path.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JOB_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=180
MAX_BUNDLE_BYTES=5242880
MAX_ARTIFACT_BYTES=1048576
MAX_BUNDLE_FILES=24
