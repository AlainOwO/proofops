# Placeholders only. Run python3 scripts/configure_local.py for local secrets.
# Never commit populated environment files or credentials.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://proofops:${POSTGRES_PASSWORD}@127.0.0.1:55432/proofops
ARTIFACT_DIR=artifacts
SECRET_KEY=
PROOFOPS_MODE=local
PROOFOPS_PUBLIC_DEMO=false
# Local HTTP only. Hosted mode requires true and a TLS reverse proxy.
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=28800
ALLOWED_HOSTS=127.0.0.1,localhost,api
# Prefer the users CLI; optional one-time bootstrap needs BOTH values.
PROOFOPS_ADMIN_USERNAME=
PROOFOPS_ADMIN_PASSWORD=
LOGIN_WINDOW_SECONDS=900
LOGIN_MAX_FAILURES=5
LOGIN_MAX_IP_ATTEMPTS=60
AI_MODE=off
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=300
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ALLOWED_PROVIDERS=
CHEAP_PROVIDER=openai
CHEAP_MODEL=
STRONG_PROVIDER=anthropic
STRONG_MODEL=
MODEL_PRICES_PATH=config/model_prices.json
AI_BUDGET_USD=0
AI_MAX_TASK_COST_USD=0
MODEL_TIMEOUT_SECONDS=20
MODEL_MAX_OUTPUT_TOKENS=1200
AWS_ACCOUNT_ID=
AWS_REGION=ap-south-1
AWS_PROFILE=
AWS_CLUSTER=
AWS_SERVICE=
AWS_LOG_GROUP=
AWS_LOOKBACK_SECONDS=3600
AWS_MAX_CALLS=12
# 0 disables collection caching. Original observation times never change on a hit.
AWS_EVIDENCE_CACHE_TTL_SECONDS=60
# Optional operator research. Disabled; never used to decide a review outcome.
SEARCH_PROVIDER=off
SEARCH_API_KEY=
SEARCH_ENGINE_ID=
SEARCH_TIMEOUT_SECONDS=5
SEARCH_MAX_RESULTS=5
SEARCH_CACHE_TTL_SECONDS=300
# Optional CLI override; empty keeps each bundle's dated rates.json. --rate-card wins.
RATE_CARD_PATH=
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JOB_LEASE_SECONDS=120
JOB_TIMEOUT_SECONDS=180
MAX_BUNDLE_BYTES=5242880
MAX_ARTIFACT_BYTES=1048576
MAX_BUNDLE_FILES=24
